# Canonical list of every environment variable this backend reads.
#
# ConfigKeysSpec asserts this file and AppConfig agree, so a key added to one but not
# the other fails the build. Copy to .env for local dev — `./gradlew run` loads that
# file, and nothing else does: the packaged jar and Docker read the real environment.
#
# Never put a real credential in this file. It is tracked in git; .env is not.

# ---- Environment ----
# dev | staging | prod. Defaults to prod when unset, so a deployment that forgets it
# fails loudly instead of silently taking the permissive local-dev path. dev relaxes
# the rules noted below; staging and prod enforce all of them.
APP_ENV=dev
# Port the process binds (read by application.yaml, not AppConfig). 8082 locally so
# it doesn't collide with the compose app container on 8080; APP_URL must agree.
APP_PORT=8082

# ---- Database (local Postgres via docker-compose) ----
DB_URL=jdbc:postgresql://localhost:5432/ibms
DB_USER=ibms
# Outside dev this must be set, and the local-dev value "ibms" is rejected.
DB_PASSWORD=ibms
DB_POOL_SIZE=10

# ---- Backend JWT (access token minted when a session starts) ----
# No default outside dev, and rejected if under 32 chars or placeholder-shaped.
# Generate one:  openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=ibms-backend
JWT_AUDIENCE=ibms-app
# Short-lived: long sessions are carried by the refresh token, not this one. Capped at
# 1440 (one day) — an access token cannot be revoked once issued.
JWT_EXPIRES_MINUTES=60
# Signs presigned attachment URLs. Optional: derived from JWT_SECRET when blank. Set
# it to rotate attachment links independently of session tokens.
PRESIGN_SECRET=

# ---- Password authentication ----
# bcrypt work factor. Raise as hardware improves; existing hashes keep verifying at
# the cost they were written with. Floors at 10 outside dev.
BCRYPT_COST=12
# How long a sysadmin-issued temporary password stays redeemable.
TEMP_PASSWORD_TTL_HOURS=72
# Refresh-token lifetime; revocable at any time from the sessions table.
REFRESH_TOKEN_TTL_DAYS=30
# Lifetime of the one-shot token that authorizes POST /auth/password/change.
PASSWORD_CHALLENGE_TTL_MINUTES=10
# Failed logins before the account is locked, and for how long.
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- First-run bootstrap ----
# The seeded sysadmin (V3) has no password. On the first startup where that is still
# true, a password is installed and flagged must-change. Ignored once a password
# exists, so this cannot be used to take over a live account.
BOOTSTRAP_ADMIN_USERNAME=mikepg
# Set a password, or set AUTOGENERATE=true to have one generated and logged exactly
# once. Outside dev, leaving both unset is a boot failure rather than a silent
# default; setting both is a contradiction and also refused.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_AUTOGENERATE_PASSWORD=

# ---- Attachment storage (local-disk adapter; storage_key holds the path) ----
STORAGE_LOCAL_DIR=./storage

# ---- Public base URL ----
# Presigned attachment links and notification links are built from this, so it must be
# the URL clients actually reach, and must match APP_PORT locally. Outside dev it
# cannot be localhost; in prod it must be https://.
APP_URL=http://localhost:8082

# ---- Outbound email ----
# smtp = real delivery through the relay below (requires SMTP_HOST).
# log  = notifications are logged, not sent; the enqueue -> dispatch pipeline still
#        runs end to end. No default outside dev: dropping every notification has to
#        be something you asked for, not something you forgot.
EMAIL_DELIVERY=log
SMTP_HOST=mbox2.puregold.com.ph
# 587 = STARTTLS submission (the default), 465 = implicit TLS, 25 = plain relay.
SMTP_PORT=587
# Leave both blank for an internal relay that takes no AUTH.
SMTP_USERNAME=puregold\ibms
SMTP_PASSWORD=
# Mutually exclusive: STARTTLS=false only for a plaintext LAN relay, SSL=true only
# with port 465. A typo in either is a boot failure, never a silent downgrade.
SMTP_STARTTLS=true
SMTP_SSL=false
# PEM for a relay whose certificate no public CA signs — our internal Exchange box is
# self-signed, so without this the TLS upgrade dies as "Could not convert socket to
# TLS". This is an EXACT pin: the relay must present byte-for-byte this certificate,
# which is why SMTP_HOST need not appear in its SANs, and why a reissued certificate
# breaks sends until the PEM is re-exported. Blank = default public-CA trust, with the
# usual hostname check. A path that isn't a readable file is a boot failure.
# See certs/README.md.
SMTP_TRUSTED_CERT=./certs/smtp-relay.pem
# The generic address notifications are sent as. Defaults to SMTP_USERNAME. Relays
# commonly reject a From they don't recognise, so this must be an address the relay
# is willing to send as.
MAIL_FROM_EMAIL=ibms@puregold.com.ph
MAIL_FROM_NAME=ISP Billing Management System

# ---- CORS (Wasm client origin, comma-separated) ----
# Empty allows any host, which is permitted only when APP_ENV=dev; outside dev an
# empty list is a boot failure rather than a silent fall-open.
CORS_ALLOWED_HOSTS=localhost:8081

# ---- Feature flags ----
# The post-compile chain: POST /topsheets/{id}/generate-rfp, /release-to-finance and
# /pay, plus the two cheque voucher exports. Off by default — the external RFP system
# has no HTTP adapter yet, so the topsheet lifecycle ends at COMPILED and the
# deliverable is GET /exports/topsheet/{id}.xlsx. While off those five routes stay
# registered and answer 503 with a message saying so, rather than 404. Set true to
# restore the external-RFP/finance chain: no data migration either way, and rows
# already past COMPILED keep listing and exporting regardless. Anything other than
# true/false fails the boot rather than reading as false.
TOPSHEET_RFP_FLOW_ENABLED=false
