# Build output
build/
.gradle/
.kotlin/

# Local env & secrets
.env

# Java keystores/truststores. The certificates the app must trust are committed as
# PEM under certs/ and loaded in-process (see certs/README.md); a .jks is a local
# convenience for the -Djavax.net.ssl.trustStore route, never the source of truth.
# Keeping them out also means a keystore holding a private key can't land here by
# accident.
*.jks
*.p12
*.keystore

# Local attachment storage (StorageService local-disk adapter)
storage/

# OS / editor / logs
.DS_Store
*.log
/.idea/compiler.xml
/.idea/AndroidProjectSystem.xml
/.idea/.name
/.claude/worktrees/
